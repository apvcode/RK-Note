            <!-- Icon 3: Осенний Янтарь -->
            <LinearLayout
                android:id="@id/icon_card_alias3"
                android:layout_width="74.0dip"
                android:layout_height="88.0dip"
                android:layout_marginEnd="8.0dip"
                android:background="@drawable/bg_theme_icon_card_inactive"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true">
                <ImageView
                    android:layout_width="42.0dip"
                    android:layout_height="42.0dip"
                    android:src="@mipmap/ic_launcher_3" />
                <TextView
