        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Оформление и кастомизация"
            android:textColor="#FFFFFFFF"
            android:textSize="17.0sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@id/theme_btn_close"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#FFA0A0A8" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.0dip"
        android:layout_marginBottom="14.0dip"
        android:text="Настройте тему, цвета интерфейса и иконку приложения"
        android:textColor="#FFA0A0A8"
        android:textSize="12.5sp"
        android:fontFamily="sans-serif" />

    <!-- SECTION 1: ТЕМА ОФОРМЛЕНИЯ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:text="ТЕМА ОФОРМЛЕНИЯ"
        android:textColor="#80FFFFFF"
        android:textSize="11.0sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16.0dip">

        <!-- 1. OLED -->
        <FrameLayout
            android:id="@id/theme_chip_oled"
            android:layout_width="0.0dip"
            android:layout_height="42.0dip"
            android:layout_weight="1.0"
            android:layout_marginEnd="4.0dip"
            android:background="@drawable/bg_dock_chip_active"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="OLED"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>

        <!-- 2. Dark -->
        <FrameLayout
            android:id="@id/theme_chip_dark"
            android:layout_width="0.0dip"
            android:layout_height="42.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="2.0dip"
            android:layout_marginEnd="2.0dip"
            android:background="@drawable/bg_dock_chip_inactive"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Тёмная"
                android:textColor="#FFA0A0A8"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>

        <!-- 3. Light -->
        <FrameLayout
            android:id="@id/theme_chip_light"
            android:layout_width="0.0dip"
            android:layout_height="42.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="2.0dip"
            android:layout_marginEnd="2.0dip"
            android:background="@drawable/bg_dock_chip_inactive"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Светлая"
                android:textColor="#FFA0A0A8"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>

        <!-- 4. Material You -->
        <FrameLayout
            android:id="@id/theme_chip_material"
            android:layout_width="0.0dip"
            android:layout_height="42.0dip"
            android:layout_weight="1.2"
            android:layout_marginStart="4.0dip"
            android:background="@drawable/bg_dock_chip_inactive"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Material You"
                android:textColor="#FFA0A0A8"
                android:textSize="12.0sp"
                android:fontFamily="sans-serif-medium" />
        </FrameLayout>
    </LinearLayout>

    <!-- SECTION 2: АКЦЕНТНЫЙ ЦВЕТ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:text="ОСНОВНОЙ АКЦЕНТНЫЙ ЦВЕТ"
        android:textColor="#80FFFFFF"
        android:textSize="11.0sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="48.0dip"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16.0dip">

        <!-- 1. Blue -->
        <FrameLayout
            android:id="@id/color_circle_blue"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@drawable/bg_theme_color_ring"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FF0A84FF" />
        </FrameLayout>

        <!-- 2. Emerald -->
        <FrameLayout
            android:id="@id/color_circle_emerald"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FF10B981" />
        </FrameLayout>

        <!-- 3. Lilac -->
        <FrameLayout
            android:id="@id/color_circle_violet"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FFC084FC" />
        </FrameLayout>

        <!-- 4. Ruby -->
        <FrameLayout
            android:id="@id/color_circle_ruby"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FFF43F5E" />
        </FrameLayout>

        <!-- 5. Amber -->
        <FrameLayout
            android:id="@id/color_circle_amber"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FFF59E0B" />
        </FrameLayout>

        <!-- 6. Pink -->
        <FrameLayout
            android:id="@id/color_circle_pink"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
                android:layout_width="30.0dip"
                android:layout_height="30.0dip"
                android:layout_gravity="center"
                android:background="@drawable/bg_theme_color_swatch"
                android:backgroundTint="#FFEC4899" />
        </FrameLayout>

        <!-- 7. Cyan -->
        <FrameLayout
            android:id="@id/color_circle_cyan"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip"
            android:layout_margin="3.0dip"
            android:background="@android:color/transparent"
            android:clickable="true">
            <View
