<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Frosted Glass Body Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_top_bar_start"
                android:endColor="@color/glass_top_bar_end"
                android:angle="270" />
        </shape>
    </item>

    <!-- Layer 1: Upper Surface Sheen Reflection -->
    <item
        android:top="0.0dip"
        android:bottom="20.0dip">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_top_bar_sheen"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>

    <!-- Layer 2: Bottom Physical Glass Edge / Luminous Rim -->
    <item
        android:top="-4.0dip"
        android:left="-4.0dip"
        android:right="-4.0dip">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.2dip"
                android:color="@color/glass_top_bar_rim" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
