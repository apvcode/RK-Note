<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bell_editor_blur" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="10dp" android:background="@drawable/bg_schedule_settings_dialog" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/bell_editor_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Оставьте строку пустой, если этого урока нет" android:textColor="#B8FFFFFF" android:textSize="12sp" />
  <ScrollView android:layout_width="match_parent" android:layout_height="390dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№1" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_1_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="08:30" android:inputType="time" android:textColor="#FFFFFFFF" android:textColorHint="#88FFFFFF"/><EditText android:id="@+id/bell_1_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="09:15" android:inputType="time" android:textColor="#FFFFFFFF" android:textColorHint="#88FFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№2" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_2_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_2_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№3" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_3_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_3_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№4" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_4_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_4_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№5" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_5_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_5_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№6" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_6_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_6_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№7" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_7_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_7_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"><TextView android:layout_width="52dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="№8" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_8_start" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/><EditText android:id="@+id/bell_8_end" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:inputType="time" android:textColor="#FFFFFFFF"/></LinearLayout>
  </LinearLayout></ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="end|center_vertical"><TextView android:id="@+id/bell_editor_cancel" android:layout_width="100dp" android:layout_height="44dp" android:gravity="center" android:text="Отмена" android:textColor="#DDFFFFFF"/><TextView android:id="@+id/bell_editor_save" android:layout_width="110dp" android:layout_height="44dp" android:background="@drawable/bg_schedule_action_card" android:gravity="center" android:text="Сохранить" android:textColor="#FFFFFFFF"/></LinearLayout>
 </LinearLayout>
</eightbitlab.com.blurview.BlurView>
