<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_personal_dialog_glass"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:clipChildren="true"
    android:tag="rk_personal_dialog_blur">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_personal_homework"
            android:drawablePadding="9dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFF8FAFC"
            android:textSize="18sp"
            android:tag="rk_personal_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Видно только вам"
            android:textColor="#FFB9AFC9"
            android:textSize="12sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_schedule_action_card"
            android:gravity="top|start"
            android:hint="Что нужно сделать?"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:maxLines="8"
            android:padding="12dp"
            android:textColor="#FFF8FAFC"
            android:textColorHint="#FF94A3B8"
            android:textSize="15sp"
            android:tag="rk_personal_edit" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="Отмена"
                android:textColor="#FFD9DDE7"
                android:textSize="14sp"
                android:tag="rk_personal_cancel" />

            <TextView
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_schedule_action_card"
                android:gravity="center"
                android:text="Сохранить"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:tag="rk_personal_save" />
        </LinearLayout>
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>
