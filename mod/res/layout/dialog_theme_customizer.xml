        android:layout_width="fill_parent"
        android:layout_height="54.0dip"
        android:layout_marginBottom="16.0dip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14.0dip"
        android:paddingEnd="12.0dip"
        android:background="@drawable/bg_dock_btn_secondary"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:gravity="center"
            android:text="✦"
            android:textSize="19.0sp"
            android:textColor="#FFC084FC" />

        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="8.0dip"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Интерфейс и отображение"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.0dip"
                android:text="Блюр, карточки, размер и оценки"
                android:textColor="#8FFFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#FFA0A0A8"
            android:textSize="28.0sp" />
    </LinearLayout>

    <!-- Greeting notification switch -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="54.0dip"
        android:layout_marginBottom="16.0dip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14.0dip"
        android:paddingEnd="10.0dip"
        android:background="@drawable/bg_dock_btn_secondary">

        <ImageView
            android:layout_width="28.0dip"
            android:layout_height="28.0dip"
            android:src="@drawable/ic_greeting_morning"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="11.0dip"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Приветствие в дневнике"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.0dip"
                android:text="Показывать при запуске приложения"
                android:textColor="#8FFFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@id/greetingSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:contentDescription="Приветствие в дневнике"
            app:thumbTint="#FFFFFFFF"
            app:trackTint="#800A84FF" />
    </LinearLayout>

    <!-- MCP server: lets the assistant on this phone (devx) read the schedule, homework and marks -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16.0dip"
        android:orientation="vertical"
        android:paddingStart="14.0dip"
        android:paddingEnd="10.0dip"
        android:background="@drawable/bg_dock_btn_secondary">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="54.0dip"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:src="@drawable/ic_rk_mcp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="11.0dip"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MCP-сервер"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.0dip"
                    android:text="Ассистент devx на этом телефоне читает расписание и ДЗ"
                    android:textColor="#8FFFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:tag="rk_mcp_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="MCP-сервер"
                app:thumbTint="#FFFFFFFF"
                app:trackTint="#800A84FF" />
        </LinearLayout>

        <LinearLayout
            android:tag="rk_mcp_panel"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4.0dip"
            android:layout_marginBottom="12.0dip"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:tag="rk_mcp_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8FFFFFFF"
                android:textSize="10.5sp" />

            <TextView
                android:tag="rk_mcp_token"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:textColor="#FFFFFFFF"
                android:textSize="11.0sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:orientation="horizontal">

                <TextView
                    android:tag="rk_mcp_copy"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:layout_weight="1.0"
                    android:gravity="center"
                    android:text="Скопировать токен"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:background="@drawable/bg_dock_btn_primary" />

                <TextView
                    android:tag="rk_mcp_renew"
                    android:layout_width="0.0dip"
                    android:layout_height="40.0dip"
                    android:layout_weight="0.8"
                    android:layout_marginStart="8.0dip"
                    android:gravity="center"
                    android:text="Новый токен"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:clickable="true"
                    android:background="@drawable/bg_dock_btn_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="В devx: MCP-серверы → RK Note → вставьте токен. Сервер слушает только этот телефон."
                android:textColor="#8FFFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION 3: ИКОНКА ПРИЛОЖЕНИЯ -->
