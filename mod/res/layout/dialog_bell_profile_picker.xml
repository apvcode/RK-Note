<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bell_picker_blur" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="18dp" android:background="@drawable/bg_schedule_settings_dialog" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Профили звонков" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="16dp" android:text="Время каждого урока задаётся вручную" android:textColor="#B8FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/bell_profile_45" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_schedule_action_card" android:gravity="center_vertical" android:paddingStart="18dp" android:text="45 минут" android:textColor="#FFFFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/bell_profile_40" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_schedule_action_card" android:gravity="center_vertical" android:paddingStart="18dp" android:text="40 минут" android:textColor="#FFFFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/bell_profile_35" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_schedule_action_card" android:gravity="center_vertical" android:paddingStart="18dp" android:text="35 минут" android:textColor="#FFFFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/bell_assign_days" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="end" android:layout_marginTop="10dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Назначить профили по дням" android:textColor="#FF80DEEA" android:textSize="13sp" />
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>
