<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/dock_customizer_sheet"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="16.0dip"
    android:layout_marginBottom="20.0dip"
    android:background="@drawable/bg_personal_dialog_glass"
    android:outlineProvider="background"
    android:clipToOutline="true"
    android:clipChildren="true">

<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16.0dip"
    android:paddingEnd="16.0dip"
    android:paddingTop="12.0dip"
    android:paddingBottom="24.0dip">

    <!-- Top drag handle -->
    <View
        android:layout_width="38.0dip"
        android:layout_height="4.0dip"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dock_drag_handle" />

    <!-- Title & Theme Palette Button -->
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Настройка нижней панели"
            android:textColor="#FFFFFFFF"
            android:textSize="17.0sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@id/dock_btn_theme_settings"
            android:layout_width="32.0dip"
            android:layout_height="32.0dip"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="5.0dip"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_theme_palette"
            android:tint="#FFA0A0A8"
            android:contentDescription="Оформление" />
    </RelativeLayout>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="16.0dip"
        android:text="Выберите 2–6 кнопок. Зажмите карточку, чтобы поставить её первой"
        android:textColor="#FFA0A0A8"
        android:textSize="12.5sp"
        android:fontFamily="sans-serif" />

    <!-- Items Grid Container -->
    <LinearLayout
        android:id="@id/dock_items_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Дневник & Оценки -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8.0dip">

            <!-- 1. Дневник -->
            <FrameLayout
                android:id="@id/dock_chip_diary"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginEnd="5.0dip"
                android:background="@drawable/bg_dock_chip_active"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_book" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Дневник"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/theme_chip_oled" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>

            <!-- 2. Оценки -->
            <FrameLayout
                android:id="@id/dock_chip_marks"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="5.0dip"
                android:background="@drawable/bg_dock_chip_active"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_grid" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Оценки"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/theme_chip_dark" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 2: Расписание & Обновления -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8.0dip">

            <!-- 3. Расписание -->
            <FrameLayout
                android:id="@id/dock_chip_schedule"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginEnd="5.0dip"
                android:background="@drawable/bg_dock_chip_inactive"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_bell" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Расписание"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:visibility="invisible"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/theme_chip_light" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>

            <!-- 4. Обновления -->
            <FrameLayout
                android:id="@id/dock_chip_updates"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="5.0dip"
                android:background="@drawable/bg_dock_chip_inactive"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_news" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Обновления"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:visibility="invisible"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/theme_chip_material" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 3: Итоговые & Сообщения -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8.0dip">

            <!-- 5. Итоговые -->
            <FrameLayout
                android:id="@id/dock_chip_finalmarks"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginEnd="5.0dip"
                android:background="@drawable/bg_dock_chip_inactive"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_school_hat" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Итоговые"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:visibility="invisible"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/color_circle_blue" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>

            <!-- 6. Сообщения -->
            <FrameLayout
                android:id="@id/dock_chip_messages"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="5.0dip"
                android:background="@drawable/bg_dock_chip_active"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_envelope" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Сообщения"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/color_circle_violet" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>
        </LinearLayout>

        <!-- Row 4: Объявления & Меню -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14.0dip">

            <!-- 7. Объявления -->
            <FrameLayout
                android:id="@id/dock_chip_announcements"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginEnd="5.0dip"
                android:background="@drawable/bg_dock_chip_active"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_announcements" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Объявления"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/color_circle_emerald" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>

            <!-- 8. Меню -->
            <FrameLayout
                android:id="@id/dock_chip_drawer"
                android:layout_width="0.0dip"
                android:layout_height="48.0dip"
                android:layout_weight="1.0"
                android:layout_marginStart="5.0dip"
                android:background="@drawable/bg_dock_chip_active"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12.0dip"
                    android:paddingEnd="42.0dip">
                    <ImageView
                        android:layout_width="22.0dip"
                        android:layout_height="22.0dip"
                        android:tint="#FFFFFFFF"
                        app:srcCompat="@drawable/ic_drawer_menu" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        android:text="Меню"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />
                    <ImageView
                        android:tag="check_icon"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        app:srcCompat="@drawable/ic_dock_check" />
                </LinearLayout>
                <TextView android:id="@id/color_circle_ruby" android:layout_width="30.0dip" android:layout_height="48.0dip" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="↑" android:textColor="#CCFFFFFF" android:textSize="21.0sp" android:clickable="true" android:focusable="true" android:contentDescription="Переместить первым" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions: Сброс & Применить -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4.0dip">

        <TextView
            android:id="@id/dock_btn_reset"
            android:layout_width="0.0dip"
            android:layout_height="46.0dip"
            android:layout_weight="1.0"
            android:layout_marginEnd="8.0dip"
            android:background="@drawable/bg_dock_btn_secondary"
            android:gravity="center"
            android:text="По умолчанию"
            android:textColor="#FFA0A0A8"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@id/dock_btn_save"
            android:layout_width="0.0dip"
            android:layout_height="46.0dip"
            android:layout_weight="1.3"
            android:background="@drawable/bg_dock_btn_primary"
            android:gravity="center"
            android:text="Применить"
            android:textColor="#FFFFFFFF"
            android:textSize="14.0sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
</eightbitlab.com.blurview.BlurView>
