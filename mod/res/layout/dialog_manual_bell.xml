<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/manualBellDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_personal_dialog_glass"
    android:outlineProvider="background"
    android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Поправить текущий звонок" android:textColor="#FFFFFFFF"
            android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="Действует только сегодня. Остальные звонки сдвинутся вместе."
            android:textColor="#CCFFFFFF" android:textSize="13sp" />
        <Spinner android:id="@id/manualBellLesson" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="16dp" />
        <Spinner android:id="@id/manualBellPhase" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="8dp" />
        <EditText android:id="@id/manualBellMinutes" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="8dp"
            android:hint="Сколько минут осталось" android:inputType="number"
            android:maxLength="3" android:textColor="#FFFFFFFF"
            android:textColorHint="#AAFFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <TextView android:id="@id/manualBellReset" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:gravity="center"
                android:background="@drawable/bg_schedule_action_card" android:text="Сбросить"
                android:textColor="#D9FFFFFF" android:clickable="true" />
            <TextView android:id="@id/manualBellSave" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="10dp"
                android:gravity="center" android:background="@drawable/bg_schedule_action_card"
                android:text="Сохранить" android:textColor="#FFFFFFFF" android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>
